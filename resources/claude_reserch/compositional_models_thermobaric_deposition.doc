@article{ZhuOkuno2016,
  author = {Zhu, D. and Okuno, R.},
  title = {Multiphase isenthalpic flash integrated with stability analysis},
  journal = {Fluid Phase Equilibria}, volume = {423}, pages = {203--219}, year = {2016}}

